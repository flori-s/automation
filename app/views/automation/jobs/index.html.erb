<ol class="breadcrumb">
  <li class="breadcrumb-item active" aria-current="page"><%= t("automation.jobs.title") %></li>
</ol>

<div class="card">
  <div class="card-header"><%= t("automation.jobs.title") %></div>
  <div class="card-body">
    <div class="automation-filters" aria-label="<%= t("automation.jobs.filters_label") %>">
      <% button_classes = { "pending" => "btn-primary", "running" => "btn-info", "completed" => "btn-success", "failed" => "btn-danger", "cancelled" => "btn-warning" } %>
      <% automation_job_statuses.each do |status| %>
        <%= link_to automation_job_status_label(status),
              root_path(status: status),
              class: "btn #{button_classes.fetch(status, "btn-secondary")} #{@status == status ? "active" : ""}" %>
      <% end %>
    </div>

    <% if @automation_jobs.empty? %>
      <p class="text-muted mb-0"><%= t("automation.jobs.empty") %></p>
    <% else %>
      <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
          <thead>
            <tr>
              <th><%= t("automation.jobs.columns.rule") %></th>
              <th><%= t("automation.jobs.columns.target") %></th>
              <th><%= t("automation.jobs.columns.run_at") %></th>
              <th><%= t("automation.jobs.columns.executed_at") %></th>
              <th><%= t("automation.jobs.columns.attempts") %></th>
            </tr>
          </thead>
          <tbody>
            <% @automation_jobs.each do |job| %>
              <tr>
                <td data-label="<%= t("automation.jobs.columns.rule") %>"><%= job.rule.name %></td>
                <td data-label="<%= t("automation.jobs.columns.target") %>"><%= job.target_type %> #<%= job.target_id %></td>
                <td data-label="<%= t("automation.jobs.columns.run_at") %>"><%= l(job.run_at, format: :short) %></td>
                <td data-label="<%= t("automation.jobs.columns.executed_at") %>"><%= job.executed_at ? l(job.executed_at, format: :short) : t("automation.jobs.blank") %></td>
                <td data-label="<%= t("automation.jobs.columns.attempts") %>"><%= job.attempts %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @total_pages > 1 %>
      <nav class="mt-3" aria-label="<%= t("automation.jobs.pages_label") %>">
        <ul class="pagination mb-0">
          <li class="page-item <%= "disabled" if @page <= 1 %>">
            <% if @page > 1 %>
              <%= link_to t("automation.jobs.previous"), root_path(status: @status, page: @page - 1), class: "page-link" %>
            <% else %>
              <span class="page-link"><%= t("automation.jobs.previous") %></span>
            <% end %>
          </li>
          <li class="page-item disabled">
            <span class="page-link"><%= @page %> / <%= @total_pages %></span>
          </li>
          <li class="page-item <%= "disabled" if @page >= @total_pages %>">
            <% if @page < @total_pages %>
              <%= link_to t("automation.jobs.next"), root_path(status: @status, page: @page + 1), class: "page-link" %>
            <% else %>
              <span class="page-link"><%= t("automation.jobs.next") %></span>
            <% end %>
          </li>
        </ul>
      </nav>
    <% end %>
  </div>
</div>
