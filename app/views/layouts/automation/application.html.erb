<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= t("automation.nav.label") %></title>
    <%= stylesheet_link_tag "automation/application" %>
    <%= javascript_include_tag "automation/application" %>
    <%= csrf_meta_tags %>
  </head>
  <body>
    <nav class="navbar navbar-expand-md navbar-dark automation-navbar">
      <div class="container">
        <%= link_to t("automation.nav.label"), root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#automation-nav" aria-controls="automation-nav" aria-expanded="false" aria-label="<%= t("automation.nav.toggle") %>">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="automation-nav">
          <ul class="navbar-nav ml-auto">
            <li class="nav-item <%= "active" if @automation_section == :jobs %>">
              <%= link_to t("automation.nav.jobs"), root_path, class: "nav-link" %>
            </li>
            <li class="nav-item <%= "active" if @automation_section == :rules %>">
              <%= link_to t("automation.nav.rules"), rules_path, class: "nav-link" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container py-3">
      <% if notice.present? %>
        <div class="alert alert-success" role="alert"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger" role="alert"><%= alert %></div>
      <% end %>

      <%= yield %>

      <footer>
        <hr>
        <p>&copy; <%= Date.current.year %> <%= t("automation.footer.credit") %></p>
      </footer>
    </div>
  </body>
</html>
